
# Server
PORT=3000
LOCALDROP_HOST=0.0.0.0
LOCALDROP_ADVERTISED_HOST=192.168.29.20

# Storage
LOCALDROP_STORAGE_DIR=./data/uploads
LOCALDROP_DATABASE_PATH=./data/localdrop.db

# Upload limits
LOCALDROP_MAX_FILE_SIZE=1073741824
LOCALDROP_MAX_CONCURRENT_UPLOADS=3

# File expiration
LOCALDROP_FILE_EXPIRY_HOURS=24

# Pairing
LOCALDROP_PAIRING_REQUIRED=true
LOCALDROP_PAIRING_EXPIRATION_HOURS=24
LOCALDROP_PAIRING_PIN=
